{
  "name": "poteto-kit-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "check:features": "tsx scripts/check-features.ts",
    "verify:coverage": "tsx scripts/verify-coverage.ts",
    "verify:reached": "tsx scripts/verify-coverage.ts --reached",
    "test:guardrails": "tsx --test scripts/guardrails.test.ts",
    "verify": "tsx scripts/verify/cli.ts",
    "verify:all": "tsx scripts/verify/cli.ts --all",
    "verify:selftest": "tsx scripts/verify/selftest.ts",
    "gate": "npm run lint && npm run typecheck && npm run check:deps && npm run check:features && npm run test:guardrails && npm run verify:coverage && npm run verify:all && npm run verify:reached && npm run verify:selftest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
